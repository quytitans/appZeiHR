# Dùng chung cho docker-compose. Copy thành `.env` trước khi chạy `docker compose up`.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=hrm_db
MYSQL_USER=hrm_user
MYSQL_PASSWORD=hrm_password
MYSQL_PORT=3306

# --- Backend ---
DATABASE_URL=mysql+pymysql://hrm_user:hrm_password@db:3306/hrm_db
SECRET_KEY=change-me-to-a-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# --- Frontend ---
VITE_API_URL=http://localhost:8000/api/v1
FRONTEND_PORT=5173
